# Copy to .env and fill in locally. Never commit .env.
# All values below are placeholders.

# Required for photo analysis and writing (not for tests).
ANTHROPIC_API_KEY=replace-me

# Optional overrides (defaults live in src/listing_assistant/config.py).
LA_MODEL=claude-opus-5
LA_DATA_DIR=data
LA_MAX_PHOTOS_PER_LISTING=20
LA_MAX_PHOTO_BYTES=10485760
LA_MAX_LLM_CALLS_PER_LISTING=40
